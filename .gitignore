.claude/scheduled_tasks.lock

# Claude Code local permissions and machine-specific paths
/.claude/settings.local.json

# Release artifacts
/dist/

# Personal development notes and local evaluation caches (never published)
/.local-dev/

# Internal assistant state and private work logs
/.claude/
